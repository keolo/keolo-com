{
  "name": "keolo-com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website of Keolo — Partner & CTO at Aliveness Ventures, built with Astro, Tailwind CSS v4, and Mermaid v13 Alpha.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-node.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^7.4.13",
    "mermaid": "13.0.0-alpha.3",
    "tailwindcss": "^4.2.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
