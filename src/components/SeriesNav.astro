---
export interface SeriesChapter {
  slug: string;
  title: string;
}

export interface Props {
  seriesTitle: string;
  chapters: SeriesChapter[];
  currentSlug: string;
}

const { seriesTitle, chapters, currentSlug } = Astro.props;
const currentIndex = chapters.findIndex((c) => c.slug === currentSlug);
const prevChapter = currentIndex > 0 ? chapters[currentIndex - 1] : null;
const nextChapter =
  currentIndex >= 0 && currentIndex < chapters.length - 1 ? chapters[currentIndex + 1] : null;
---

<aside class="my-10 rounded-2xl border border-graphite-200 bg-white p-6">
  <p class="text-xs font-semibold tracking-wider text-graphite-500 uppercase">Series</p>
  <h2 class="mt-1 text-lg font-semibold text-graphite-950">{seriesTitle}</h2>
  <ol class="mt-4 space-y-1.5 text-sm">
    {
      chapters.map((chapter, idx) => (
        <li>
          <a
            href={`/posts/${chapter.slug}/`}
            class:list={[
              'flex items-center gap-2 rounded-lg px-2.5 py-1.5 transition-colors',
              chapter.slug === currentSlug
                ? 'bg-graphite-900 font-medium text-white'
                : 'text-graphite-700 hover:bg-graphite-100 hover:text-graphite-950',
            ]}
          >
            <span class="font-mono text-xs opacity-60">{String(idx + 1).padStart(2, '0')}</span>
            <span>{chapter.title}</span>
          </a>
        </li>
      ))
    }
  </ol>

  {
    (prevChapter || nextChapter) && (
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-graphite-200 pt-4 text-sm">
        {prevChapter ? (
          <a
            href={`/posts/${prevChapter.slug}/`}
            class="font-medium text-graphite-700 hover:text-graphite-950"
          >
            ← {prevChapter.title}
          </a>
        ) : (
          <span />
        )}
        {nextChapter && (
          <a
            href={`/posts/${nextChapter.slug}/`}
            class="font-medium text-graphite-700 hover:text-graphite-950"
          >
            {nextChapter.title} →
          </a>
        )}
      </div>
    )
  }
</aside>
