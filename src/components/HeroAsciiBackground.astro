---
// src/components/HeroAsciiBackground.astro
---

<canvas
  id="hero-ascii-bg"
  class="absolute inset-0 w-full h-full pointer-events-none z-0"
  aria-hidden="true"></canvas>

<script>
  (() => {
    // === Configuration ===
    const CONFIG = {
      cellW: 9,
      cellH: 10,
      fontSize: 10,
      bgColor: '#09090b',
      bgShimmerCount: 20, // Standby shimmer when active
    };

    const CHARS_LIGHT = ['░', '▖', '▗', '▘', '▝'];
    const CHARS_MEDIUM = ['▒', '▀', '▄', '▌', '▐', '▞', '▚'];
    const CHARS_DENSE = ['█', '▓', '▛', '▜', '▙', '▟', '▀', '▄', '▌', '▐'];
    const CHARS_BG = ['░', '▒', '▖', '▗', '▘', '▝', '▚', '▞', '▀', '▄', '▌', '▐'];

    const PALETTE = [
      [255, 59, 48], // Red
      [255, 112, 52], // Coral / Orange
      [255, 179, 38], // Amber
      [245, 224, 52], // Yellow
      [120, 235, 72], // Lime
      [34, 214, 118], // Emerald
      [24, 218, 224], // Cyan
      [56, 152, 255], // Sky Blue
      [99, 102, 241], // Indigo
      [176, 102, 255], // Violet
      [244, 72, 150], // Magenta
    ];

    const WHITE_HIGHLIGHT = [245, 248, 255];
    const BG_TEXT_BASE = [24, 24, 28];

    const canvas = document.getElementById('hero-ascii-bg') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    const baseCanvas = document.createElement('canvas');
    const baseCtx = baseCanvas.getContext('2d', { alpha: false });
    if (!baseCtx) return;

    const FONT = `${CONFIG.fontSize}px "JetBrains Mono", "SF Mono", ui-monospace, Menlo, Consolas, monospace`;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let cols = 0;
    let rows = 0;

    // === Simulation Modes ===
    const MODES = ['rain', 'life', 'contours', 'orchestrator', 'agents', 'lattice'] as const;
    type Mode = (typeof MODES)[number];

    function pick<T>(arr: readonly T[] | T[]): T {
      return arr[(Math.random() * arr.length) | 0];
    }

    const STORAGE_KEY = 'keolo_hero_bg_idx';

    function getNextMode(): Mode {
      // 1. Direct URL override for testing: ?bg=<mode>
      try {
        const urlParam = new URLSearchParams(window.location.search).get('bg') as Mode;
        if (urlParam && (MODES as readonly string[]).includes(urlParam)) {
          return urlParam;
        }
      } catch {
        // Sandbox / non-browser guard
      }

      // 2. Cycle sequentially through available options across page refreshes
      let nextIdx = 0;
      try {
        const stored = sessionStorage.getItem(STORAGE_KEY) || localStorage.getItem(STORAGE_KEY);
        if (stored !== null) {
          const parsed = parseInt(stored, 10);
          if (!isNaN(parsed)) {
            nextIdx = (parsed + 1) % MODES.length;
          } else {
            const prevIdx = MODES.indexOf(stored as Mode);
            nextIdx =
              prevIdx >= 0 ? (prevIdx + 1) % MODES.length : (Math.random() * MODES.length) | 0;
          }
        } else {
          // First visit starts at a random mode, subsequent refreshes cycle in order
          nextIdx = (Math.random() * MODES.length) | 0;
        }

        sessionStorage.setItem(STORAGE_KEY, String(nextIdx));
        localStorage.setItem(STORAGE_KEY, String(nextIdx));
      } catch {
        nextIdx = (Math.random() * MODES.length) | 0;
      }

      return MODES[nextIdx];
    }

    const mode: Mode = getNextMode();

    // Expose selected mode for developer inspection / debugging
    (window as unknown as { __heroBgMode?: string }).__heroBgMode = mode;

    // === Life Simulation State (Empty until mouse interaction) ===
    let lifeGrid: Uint8Array;
    let nextLifeGrid: Uint8Array;
    let lifeAge: Uint8Array;
    let liveCount = 0;
    let lastLifeStep = performance.now();

    // === Rain Simulation State (Empty until mouse interaction) ===
    interface RainDrop {
      col: number;
      row: number;
      endRow: number;
      speed: number;
      lastRow: number;
      color: number[];
      decay: number;
    }
    const activeDrops: RainDrop[] = [];

    // === Contours Simulation State (Topographic / Elevation waves) ===
    interface ContourRipple {
      cx: number;
      cy: number;
      radius: number;
      maxRadius: number;
      speed: number;
      color: number[];
      strength: number;
      decay: number;
      frequency: number;
    }
    const activeRipples: ContourRipple[] = [];

    // === Orchestrator Simulation State (Hub & Worker Task Packets) ===
    interface TaskPacket {
      x: number;
      y: number;
      targetX: number;
      targetY: number;
      speed: number;
      color: number[];
      char: string;
    }
    const activePackets: TaskPacket[] = [];

    // === Agents Simulation State (Autonomous swarm agents) ===
    interface SwarmAgent {
      x: number;
      y: number;
      vx: number;
      vy: number;
      color: number[];
      life: number;
    }
    const activeAgents: SwarmAgent[] = [];

    // === Lattice Simulation State (Crystal / Quantum grid resonance) ===
    interface LatticePulse {
      type: 'axis' | 'wave';
      centerCol: number;
      centerRow: number;
      dist: number;
      maxDist: number;
      speed: number;
      color: number[];
      decay: number;
    }
    const activeLatticePulses: LatticePulse[] = [];

    // === Active Display Cells ===
    interface ActiveCell {
      col: number;
      row: number;
      energy: number;
      decay: number;
      isWhite: boolean;
      r: number;
      g: number;
      b: number;
      char: string;
      nextMutate: number;
    }
    const activeCells = new Map<number, ActiveCell>();

    function cellHash(col: number, row: number) {
      let h = (col * 374761393 + row * 668265263) | 0;
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return (h ^ (h >>> 16)) >>> 0;
    }

    function charForEnergy(energy: number, hash?: number) {
      const list = energy > 0.65 ? CHARS_DENSE : energy > 0.3 ? CHARS_MEDIUM : CHARS_LIGHT;
      return hash !== undefined ? list[hash % list.length] : pick(list);
    }

    function bgShadeAt(col: number, row: number) {
      const wave =
        Math.sin(col * 0.17 + row * 0.09) * 0.5 + Math.cos(col * 0.08 - row * 0.21) * 0.5;
      const jitter = (Math.random() - 0.5) * 10;
      const v = Math.max(14, Math.min(34, Math.round(21 + wave * 4 + jitter)));
      return `rgb(${v}, ${v}, ${v + 2})`;
    }

    function drawBaseCell(col: number, row: number) {
      const x = col * CONFIG.cellW;
      const y = row * CONFIG.cellH;
      baseCtx!.fillStyle = CONFIG.bgColor;
      baseCtx!.fillRect(x, y, CONFIG.cellW, CONFIG.cellH);
      baseCtx!.fillStyle = bgShadeAt(col, row);
      baseCtx!.fillText(pick(CHARS_BG), x + CONFIG.cellW * 0.5, y + CONFIG.cellH * 0.5);
    }

    function setupCanvas(targetCanvas: HTMLCanvasElement, targetCtx: CanvasRenderingContext2D) {
      targetCanvas.width = Math.floor(width * dpr);
      targetCanvas.height = Math.floor(height * dpr);
      targetCanvas.style.width = `${width}px`;
      targetCanvas.style.height = `${height}px`;
      targetCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      targetCtx.font = FONT;
      targetCtx.textAlign = 'center';
      targetCtx.textBaseline = 'middle';
    }

    function rebuildBaseGrid() {
      baseCtx!.fillStyle = CONFIG.bgColor;
      baseCtx!.fillRect(0, 0, width, height);
      for (let r = 0; r < rows; r++) {
        const cy = r * CONFIG.cellH + CONFIG.cellH * 0.5;
        for (let c = 0; c < cols; c++) {
          baseCtx!.fillStyle = bgShadeAt(c, r);
          baseCtx!.fillText(pick(CHARS_BG), c * CONFIG.cellW + CONFIG.cellW * 0.5, cy);
        }
      }
    }

    function igniteCell(
      col: number,
      row: number,
      energy: number,
      decay: number,
      rgb: number[],
      now: number,
      isWhite = false,
      customChar?: string
    ) {
      if (col < 0 || col >= cols || row < 0 || row >= rows) return;
      const idx = row * cols + col;
      const existing = activeCells.get(idx);

      if (existing) {
        if (energy >= existing.energy * 0.72) {
          existing.energy = Math.max(existing.energy, Math.min(1, energy));
          existing.decay = Math.min(existing.decay, decay);
          if (isWhite) existing.isWhite = true;
          if (rgb && energy >= 0.45) {
            existing.r = rgb[0];
            existing.g = rgb[1];
            existing.b = rgb[2];
          }
          existing.char = customChar || charForEnergy(existing.energy);
        }
      } else {
        const color = rgb || PALETTE[cellHash(col, row) % PALETTE.length];
        activeCells.set(idx, {
          col,
          row,
          energy: Math.min(1, energy),
          decay,
          r: color[0],
          g: color[1],
          b: color[2],
          isWhite,
          char: customChar || charForEnergy(Math.min(1, energy)),
          nextMutate: now + 75 + Math.random() * 140,
        });
      }
    }

    function spawnRainDrop(col: number, startRow: number, maxDist?: number) {
      if (activeDrops.length >= 140) activeDrops.shift();
      const c = Math.max(0, Math.min(cols - 1, col));
      const sRow = Math.max(0, startRow);
      activeDrops.push({
        col: c,
        row: sRow,
        endRow: Math.min(rows + 2, sRow + (maxDist || 22 + Math.random() * 44)),
        speed: 18 + Math.random() * 24,
        lastRow: sRow - 1,
        color: pick(PALETTE),
        decay: 0.85 + Math.random() * 0.85,
      });
    }

    function seedLifeCluster(cx: number, cy: number, radius: number, density: number, now: number) {
      if (cols === 0 || rows === 0 || !lifeGrid) return;
      let seeded = 0;
      for (let dy = -radius; dy <= radius; dy++) {
        for (let dx = -radius; dx <= radius; dx++) {
          if (Math.hypot(dx, dy) > radius) continue;
          if (Math.random() > density) continue;
          const c = (cx + dx + cols) % cols;
          const r = (cy + dy + rows) % rows;
          const idx = r * cols + c;
          lifeGrid[idx] = 1;
          lifeAge[idx] = 0;
          const h = cellHash(c, r);
          igniteCell(c, r, 1.0, 1.2, PALETTE[h % PALETTE.length], now, true);
          seeded++;
        }
      }
      if (seeded > 0) liveCount += seeded;
    }

    function spawnContourRipple(
      cx: number,
      cy: number,
      maxRadius?: number,
      strength = 0.9,
      speed = 22,
      startRadius = 0
    ) {
      if (activeRipples.length >= 16) activeRipples.shift();
      activeRipples.push({
        cx,
        cy,
        radius: startRadius,
        maxRadius: maxRadius || Math.min(38, Math.max(cols, rows) * 0.45),
        speed: speed + Math.random() * 8,
        color: pick(PALETTE),
        strength,
        decay: 1.1,
        frequency: 2.0 + Math.random() * 1.2,
      });
    }

    function spawnOrchestratorTask(col: number, row: number, angle?: number, dist?: number) {
      if (activePackets.length >= 48) activePackets.shift();
      const a = angle !== undefined ? angle : Math.random() * 2 * Math.PI;
      const d = dist !== undefined ? dist : 14 + Math.random() * 22;
      const targetX = Math.max(1, Math.min(cols - 2, col + Math.cos(a) * d));
      const targetY = Math.max(1, Math.min(rows - 2, row + Math.sin(a) * d));
      const packetChars = ['▲', '■', '◈', '●', '1', '0', '▞'];

      activePackets.push({
        x: col,
        y: row,
        targetX,
        targetY,
        speed: 26 + Math.random() * 18,
        color: pick(PALETTE),
        char: pick(packetChars),
      });
    }

    function spawnAgent(col: number, row: number, count = 1, angle?: number) {
      for (let i = 0; i < count; i++) {
        if (activeAgents.length >= 32) activeAgents.shift();
        const a = angle !== undefined ? angle : Math.random() * 2 * Math.PI;
        const spd = 14 + Math.random() * 16;
        activeAgents.push({
          x: col,
          y: row,
          vx: Math.cos(a) * spd,
          vy: Math.sin(a) * spd,
          color: pick(PALETTE),
          life: 3.5 + Math.random() * 2.5,
        });
      }
    }

    function spawnLatticePulse(col: number, row: number, type: 'axis' | 'wave', maxDist?: number) {
      if (activeLatticePulses.length >= 20) activeLatticePulses.shift();
      activeLatticePulses.push({
        type,
        centerCol: col,
        centerRow: row,
        dist: 0,
        maxDist:
          maxDist || (type === 'axis' ? 32 + Math.random() * 20 : Math.max(cols, rows) * 0.65),
        speed: type === 'axis' ? 44 + Math.random() * 20 : 36 + Math.random() * 14,
        color: pick(PALETTE),
        decay: type === 'axis' ? 1.4 : 1.1,
      });
    }

    function renderBaseToCanvas() {
      ctx!.setTransform(1, 0, 0, 1, 0, 0);
      ctx!.drawImage(baseCanvas, 0, 0);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const parent = canvas.parentElement;
      width = parent ? parent.clientWidth : window.innerWidth;
      height = parent ? parent.clientHeight : window.innerHeight;
      cols = Math.ceil(width / CONFIG.cellW);
      rows = Math.ceil(height / CONFIG.cellH);

      const cellsCount = cols * rows;
      lifeGrid = new Uint8Array(cellsCount);
      nextLifeGrid = new Uint8Array(cellsCount);
      lifeAge = new Uint8Array(cellsCount);
      liveCount = 0;

      setupCanvas(canvas, ctx!);
      setupCanvas(baseCanvas, baseCtx!);
      rebuildBaseGrid();
      renderBaseToCanvas();
      activeCells.clear();
      activeDrops.length = 0;
      activeRipples.length = 0;
      activePackets.length = 0;
      activeAgents.length = 0;
      activeLatticePulses.length = 0;
    }

    window.addEventListener('resize', resize);
    resize();

    let lastTime = performance.now();
    let isVisible = true;
    let animFrameId = 0;

    function ensureLoopRunning() {
      if (isVisible && !animFrameId) {
        lastTime = performance.now();
        animFrameId = requestAnimationFrame(animate);
      }
    }

    let lastMouseCol = -1;
    let lastMouseRow = -1;

    window.addEventListener('pointermove', (e) => {
      if (reducedMotion) return;
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      if (x < 0 || x > rect.width || y < 0 || y > rect.height) return;

      const col = Math.floor(x / CONFIG.cellW);
      const row = Math.floor(y / CONFIG.cellH);

      if (mode === 'rain') {
        if (col !== lastMouseCol || Math.abs(row - lastMouseRow) >= 2) {
          spawnRainDrop(col, row);
          lastMouseCol = col;
          lastMouseRow = row;
          ensureLoopRunning();
        }
      } else if (mode === 'life') {
        if (col !== lastMouseCol || row !== lastMouseRow) {
          seedLifeCluster(col, row, 2, 0.52, performance.now());
          lastMouseCol = col;
          lastMouseRow = row;
          ensureLoopRunning();
        }
      } else if (mode === 'contours') {
        if (col !== lastMouseCol || row !== lastMouseRow) {
          spawnContourRipple(col, row);
          lastMouseCol = col;
          lastMouseRow = row;
          ensureLoopRunning();
        }
      } else if (mode === 'orchestrator') {
        if (col !== lastMouseCol || row !== lastMouseRow) {
          igniteCell(col, row, 1.0, 0.9, WHITE_HIGHLIGHT, performance.now(), true, '◈');
          spawnOrchestratorTask(col, row);
          spawnOrchestratorTask(col, row);
          lastMouseCol = col;
          lastMouseRow = row;
          ensureLoopRunning();
        }
      } else if (mode === 'agents') {
        if (col !== lastMouseCol || row !== lastMouseRow) {
          igniteCell(col, row, 0.8, 1.4, WHITE_HIGHLIGHT, performance.now(), true, '✦');
          if (activeAgents.length < 24) {
            spawnAgent(col, row, 1);
          }
          lastMouseCol = col;
          lastMouseRow = row;
          ensureLoopRunning();
        }
      } else if (mode === 'lattice') {
        if (col !== lastMouseCol || row !== lastMouseRow) {
          igniteCell(col, row, 1.0, 1.0, WHITE_HIGHLIGHT, performance.now(), true, '┼');
          spawnLatticePulse(col, row, 'axis');
          lastMouseCol = col;
          lastMouseRow = row;
          ensureLoopRunning();
        }
      }
    });

    window.addEventListener('pointerdown', (e) => {
      if (reducedMotion) return;
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      if (x < 0 || x > rect.width || y < 0 || y > rect.height) return;

      const centerCol = Math.floor(x / CONFIG.cellW);
      const centerRow = Math.floor(y / CONFIG.cellH);

      if (mode === 'rain') {
        for (let i = -12; i <= 12; i++) {
          const rowOffset = Math.random() * 4 + Math.abs(i) * 0.5;
          spawnRainDrop(centerCol + i, Math.max(0, centerRow - rowOffset));
        }
        ensureLoopRunning();
      } else if (mode === 'life') {
        seedLifeCluster(centerCol, centerRow, 5, 0.45, performance.now());
        ensureLoopRunning();
      } else if (mode === 'contours') {
        for (let i = 0; i < 3; i++) {
          spawnContourRipple(centerCol, centerRow, Math.max(cols, rows) * 0.75, 1.0, 26, -i * 5);
        }
        ensureLoopRunning();
      } else if (mode === 'orchestrator') {
        igniteCell(centerCol, centerRow, 1.0, 0.5, WHITE_HIGHLIGHT, performance.now(), true, '◈');
        for (let i = 0; i < 12; i++) {
          const a = (i / 12) * Math.PI * 2;
          spawnOrchestratorTask(centerCol, centerRow, a, 22 + Math.random() * 16);
        }
        ensureLoopRunning();
      } else if (mode === 'agents') {
        for (let i = 0; i < 12; i++) {
          const a = (i / 12) * Math.PI * 2;
          spawnAgent(centerCol, centerRow, 1, a);
        }
        ensureLoopRunning();
      } else if (mode === 'lattice') {
        igniteCell(centerCol, centerRow, 1.0, 0.6, WHITE_HIGHLIGHT, performance.now(), true, '┼');
        spawnLatticePulse(centerCol, centerRow, 'wave', Math.max(cols, rows) * 0.7);
        spawnLatticePulse(centerCol, centerRow, 'axis', Math.max(cols, rows) * 0.85);
        ensureLoopRunning();
      }
    });

    const observer = new IntersectionObserver((entries) => {
      isVisible = entries[0].isIntersecting;
      if (isVisible) {
        const hasWork =
          activeCells.size > 0 ||
          activeDrops.length > 0 ||
          liveCount > 0 ||
          activeRipples.length > 0 ||
          activePackets.length > 0 ||
          activeAgents.length > 0 ||
          activeLatticePulses.length > 0;
        if (hasWork) {
          ensureLoopRunning();
        }
      } else if (animFrameId) {
        cancelAnimationFrame(animFrameId);
        animFrameId = 0;
      }
    });
    observer.observe(canvas);

    function animate(now: number) {
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;

      const hasActivity =
        activeCells.size > 0 ||
        activeDrops.length > 0 ||
        liveCount > 0 ||
        activeRipples.length > 0 ||
        activePackets.length > 0 ||
        activeAgents.length > 0 ||
        activeLatticePulses.length > 0;

      if (!reducedMotion && hasActivity && cols > 0 && rows > 0) {
        for (let i = 0; i < CONFIG.bgShimmerCount; i++) {
          drawBaseCell((Math.random() * cols) | 0, (Math.random() * rows) | 0);
        }
      }

      renderBaseToCanvas();

      const stepDt = reducedMotion ? dt * 0.35 : dt;

      // === Rain Simulation Step (Only active drops triggered by mouse) ===
      if (mode === 'rain' && !reducedMotion && activeDrops.length > 0) {
        for (let i = activeDrops.length - 1; i >= 0; i--) {
          const d = activeDrops[i];
          d.row += d.speed * stepDt;

          if (d.row >= d.endRow || d.row >= rows + 2) {
            activeDrops.splice(i, 1);
            continue;
          }

          const curRow = Math.floor(d.row);

          if (curRow !== d.lastRow && curRow >= 0 && curRow < rows) {
            const startR = Math.max(0, d.lastRow + 1);
            for (let r = startR; r <= curRow; r++) {
              const isHead = r === curRow;
              const fadeOut = Math.min(1, (d.endRow - r) / 8);
              igniteCell(
                d.col,
                r,
                (isHead ? 1.0 : 0.85) * fadeOut,
                d.decay,
                d.color,
                now,
                isHead && fadeOut > 0.5
              );
              if (Math.random() < 0.2) {
                const side = Math.random() < 0.5 ? -1 : 1;
                igniteCell(
                  d.col + side,
                  r,
                  0.45 * fadeOut,
                  1.5 + Math.random() * 0.8,
                  d.color,
                  now
                );
              }
            }
            d.lastRow = curRow;
          }
        }
      }

      // === Life Simulation Step (Only when live cells seeded by mouse) ===
      if (mode === 'life' && !reducedMotion && lifeGrid && liveCount > 0) {
        if (now - lastLifeStep >= 88) {
          lastLifeStep = now;
          let newLiveCount = 0;
          for (let r = 0; r < rows; r++) {
            const rUp = (r - 1 + rows) % rows;
            const rDn = (r + 1) % rows;
            const rowOff = r * cols;
            const upOff = rUp * cols;
            const dnOff = rDn * cols;

            for (let c = 0; c < cols; c++) {
              const cLt = (c - 1 + cols) % cols;
              const cRt = (c + 1) % cols;

              const neighbors =
                lifeGrid[upOff + cLt] +
                lifeGrid[upOff + c] +
                lifeGrid[upOff + cRt] +
                lifeGrid[rowOff + cLt] +
                lifeGrid[rowOff + cRt] +
                lifeGrid[dnOff + cLt] +
                lifeGrid[dnOff + c] +
                lifeGrid[dnOff + cRt];

              const idx = rowOff + c;
              const isAlive = lifeGrid[idx];
              const nextAlive = isAlive
                ? neighbors === 2 || neighbors === 3
                  ? 1
                  : 0
                : neighbors === 3
                  ? 1
                  : 0;

              nextLifeGrid[idx] = nextAlive;

              if (nextAlive) {
                newLiveCount++;
                const born = isAlive === 0;
                lifeAge[idx] = born ? 0 : Math.min(255, lifeAge[idx] + 1);
              } else {
                lifeAge[idx] = 0;
              }
            }
          }

          const temp = lifeGrid;
          lifeGrid = nextLifeGrid;
          nextLifeGrid = temp;
          nextLifeGrid.fill(0);
          liveCount = newLiveCount;

          for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
              const idx = r * cols + c;
              if (lifeGrid[idx]) {
                const age = lifeAge[idx];
                const energy = age === 0 ? 1.0 : Math.max(0.35, 0.85 - age * 0.02);
                const isWhite = age === 0;
                const color = PALETTE[cellHash(c, r) % PALETTE.length];
                igniteCell(c, r, energy, 0.7, color, now, isWhite);
              }
            }
          }
        }
      }

      // === Contours Simulation Step (Topographic isoline ripples) ===
      if (mode === 'contours' && !reducedMotion && activeRipples.length > 0) {
        const aspect = CONFIG.cellW / CONFIG.cellH;
        const contourChars = ['~', '≈', '≡', '·', '░', '▒'];
        for (let i = activeRipples.length - 1; i >= 0; i--) {
          const rip = activeRipples[i];
          rip.radius += rip.speed * stepDt;
          if (rip.radius < 0) continue;
          if (rip.radius >= rip.maxRadius) {
            activeRipples.splice(i, 1);
            continue;
          }

          const fade = Math.max(0, 1 - rip.radius / rip.maxRadius);
          const perimeter = Math.max(12, Math.floor(2 * Math.PI * rip.radius * 1.25));
          const angleStep = (2 * Math.PI) / perimeter;

          for (let a = 0; a < perimeter; a++) {
            const theta = a * angleStep;
            const rPerturb = rip.radius + Math.sin(theta * rip.frequency + rip.cx * 0.1) * 1.3;
            const c = Math.round(rip.cx + Math.cos(theta) * rPerturb);
            const r = Math.round(rip.cy + Math.sin(theta) * rPerturb * aspect);

            if (c >= 0 && c < cols && r >= 0 && r < rows) {
              const energy = Math.min(1, rip.strength * fade);
              const isPeak = fade > 0.75 && a % 5 === 0;
              const char = contourChars[(a + Math.floor(rip.radius)) % contourChars.length];
              igniteCell(c, r, energy, rip.decay, rip.color, now, isPeak, char);
            }
          }
        }
      }

      // === Orchestrator Simulation Step (Task packet dispatch & worker aggregation) ===
      if (mode === 'orchestrator' && !reducedMotion && activePackets.length > 0) {
        for (let i = activePackets.length - 1; i >= 0; i--) {
          const pkt = activePackets[i];
          const dx = pkt.targetX - pkt.x;
          const dy = pkt.targetY - pkt.y;
          const dist = Math.hypot(dx, dy);

          if (dist < 1.4) {
            // Worker node reached: task completed flash
            const wc = Math.round(pkt.targetX);
            const wr = Math.round(pkt.targetY);
            igniteCell(wc, wr, 1.0, 1.0, pkt.color, now, true, '◈');
            for (const [ox, oy] of [
              [1, 0],
              [-1, 0],
              [0, 1],
              [0, -1],
            ]) {
              igniteCell(wc + ox, wr + oy, 0.7, 1.6, pkt.color, now, false, '·');
            }
            activePackets.splice(i, 1);
            continue;
          }

          const move = Math.min(dist, pkt.speed * stepDt);
          pkt.x += (dx / dist) * move;
          pkt.y += (dy / dist) * move;

          const curC = Math.round(pkt.x);
          const curR = Math.round(pkt.y);
          if (curC >= 0 && curC < cols && curR >= 0 && curR < rows) {
            igniteCell(curC, curR, 0.95, 1.8, pkt.color, now, true, pkt.char);
          }
        }
      }

      // === Agents Simulation Step (Autonomous swarm agents) ===
      if (mode === 'agents' && !reducedMotion && activeAgents.length > 0) {
        const mouseActive = lastMouseCol >= 0 && lastMouseRow >= 0;
        const agentChars = ['▲', '▼', '◄', '►', '◈', '✦', '·'];
        for (let i = activeAgents.length - 1; i >= 0; i--) {
          const ag = activeAgents[i];
          ag.life -= stepDt;
          if (ag.life <= 0) {
            activeAgents.splice(i, 1);
            continue;
          }

          // Gentle steering towards cursor beacon
          if (mouseActive) {
            const mdx = lastMouseCol - ag.x;
            const mdy = lastMouseRow - ag.y;
            const mdist = Math.hypot(mdx, mdy);
            if (mdist > 2 && mdist < 34) {
              ag.vx += (mdx / mdist) * 22 * stepDt;
              ag.vy += (mdy / mdist) * 22 * stepDt;
            }
          }

          // Velocity dampening & noise
          const spd = Math.hypot(ag.vx, ag.vy);
          if (spd > 30) {
            ag.vx = (ag.vx / spd) * 30;
            ag.vy = (ag.vy / spd) * 30;
          } else if (spd < 8) {
            ag.vx += (Math.random() - 0.5) * 12;
            ag.vy += (Math.random() - 0.5) * 12;
          }

          ag.x += ag.vx * stepDt;
          ag.y += ag.vy * stepDt;

          // Soft boundary bounce
          if (ag.x < 1) {
            ag.x = 1;
            ag.vx = Math.abs(ag.vx);
          } else if (ag.x > cols - 2) {
            ag.x = cols - 2;
            ag.vx = -Math.abs(ag.vx);
          }
          if (ag.y < 1) {
            ag.y = 1;
            ag.vy = Math.abs(ag.vy);
          } else if (ag.y > rows - 2) {
            ag.y = rows - 2;
            ag.vy = -Math.abs(ag.vy);
          }

          const ac = Math.round(ag.x);
          const ar = Math.round(ag.y);
          const energy = Math.min(1, ag.life / 2);
          const headingChar =
            Math.abs(ag.vx) > Math.abs(ag.vy) ? (ag.vx > 0 ? '►' : '◄') : ag.vy > 0 ? '▼' : '▲';

          igniteCell(
            ac,
            ar,
            energy,
            0.9,
            ag.color,
            now,
            Math.random() < 0.2,
            Math.random() < 0.6 ? headingChar : pick(agentChars)
          );

          // Agent communication bridge
          if (i > 0 && Math.random() < 0.25) {
            const other = activeAgents[i - 1];
            const distOther = Math.hypot(ag.x - other.x, ag.y - other.y);
            if (distOther < 4.5) {
              const midC = Math.round((ag.x + other.x) * 0.5);
              const midR = Math.round((ag.y + other.y) * 0.5);
              igniteCell(midC, midR, 0.9, 1.8, WHITE_HIGHLIGHT, now, true, '✦');
            }
          }
        }
      }

      // === Lattice Simulation Step (Crystal resonance & orthogonal axes) ===
      if (mode === 'lattice' && !reducedMotion && activeLatticePulses.length > 0) {
        const aspect = CONFIG.cellW / CONFIG.cellH;
        for (let i = activeLatticePulses.length - 1; i >= 0; i--) {
          const pulse = activeLatticePulses[i];
          pulse.dist += pulse.speed * stepDt;
          if (pulse.dist >= pulse.maxDist) {
            activeLatticePulses.splice(i, 1);
            continue;
          }

          const fade = Math.max(0, 1 - pulse.dist / pulse.maxDist);
          const d = Math.round(pulse.dist);

          if (pulse.type === 'axis') {
            const coords: [number, number, string][] = [
              [pulse.centerCol + d, pulse.centerRow, '─'],
              [pulse.centerCol - d, pulse.centerRow, '─'],
              [pulse.centerCol, Math.round(pulse.centerRow + d * aspect), '│'],
              [pulse.centerCol, Math.round(pulse.centerRow - d * aspect), '│'],
              [
                pulse.centerCol + Math.round(d * 0.7),
                Math.round(pulse.centerRow + d * 0.7 * aspect),
                '┼',
              ],
              [
                pulse.centerCol - Math.round(d * 0.7),
                Math.round(pulse.centerRow + d * 0.7 * aspect),
                '┼',
              ],
              [
                pulse.centerCol + Math.round(d * 0.7),
                Math.round(pulse.centerRow - d * 0.7 * aspect),
                '┼',
              ],
              [
                pulse.centerCol - Math.round(d * 0.7),
                Math.round(pulse.centerRow - d * 0.7 * aspect),
                '┼',
              ],
            ];

            for (const [c, r, ch] of coords) {
              if (c >= 0 && c < cols && r >= 0 && r < rows) {
                igniteCell(c, r, fade * 0.92, pulse.decay, pulse.color, now, fade > 0.75, ch);
              }
            }
          } else if (pulse.type === 'wave') {
            const step = Math.max(1, Math.round(d / 12));
            for (let dx = -d; dx <= d; dx += step) {
              const dy = (d - Math.abs(dx)) * aspect;
              const c = pulse.centerCol + dx;
              const r1 = Math.round(pulse.centerRow + dy);
              const r2 = Math.round(pulse.centerRow - dy);

              if (c >= 0 && c < cols) {
                if (r1 >= 0 && r1 < rows) {
                  igniteCell(
                    c,
                    r1,
                    fade * 0.95,
                    pulse.decay,
                    pulse.color,
                    now,
                    fade > 0.8 && dx % 3 === 0,
                    '◈'
                  );
                }
                if (r2 >= 0 && r2 < rows && r2 !== r1) {
                  igniteCell(
                    c,
                    r2,
                    fade * 0.95,
                    pulse.decay,
                    pulse.color,
                    now,
                    fade > 0.8 && dx % 3 === 0,
                    '◈'
                  );
                }
              }
            }
          }
        }
      }

      // === Render Active Cells ===
      for (const [idx, cell] of activeCells) {
        cell.energy -= cell.decay * stepDt;

        if (cell.energy <= 0.02) {
          activeCells.delete(idx);
          continue;
        }

        if (cell.isWhite && cell.energy < 0.84) {
          cell.isWhite = false;
        }

        if (!reducedMotion && now >= cell.nextMutate) {
          cell.char = charForEnergy(cell.energy);
          cell.nextMutate = now + 85 + Math.random() * 150;
        }

        const e = Math.pow(Math.min(1, cell.energy), 0.85);
        const srcR = cell.isWhite ? WHITE_HIGHLIGHT[0] : cell.r;
        const srcG = cell.isWhite ? WHITE_HIGHLIGHT[1] : cell.g;
        const srcB = cell.isWhite ? WHITE_HIGHLIGHT[2] : cell.b;

        const r = (BG_TEXT_BASE[0] + (srcR - BG_TEXT_BASE[0]) * e) | 0;
        const g = (BG_TEXT_BASE[1] + (srcG - BG_TEXT_BASE[1]) * e) | 0;
        const b = (BG_TEXT_BASE[2] + (srcB - BG_TEXT_BASE[2]) * e) | 0;

        const x = cell.col * CONFIG.cellW;
        const y = cell.row * CONFIG.cellH;

        ctx!.fillStyle = CONFIG.bgColor;
        ctx!.fillRect(x, y, CONFIG.cellW, CONFIG.cellH);
        ctx!.fillStyle = `rgb(${r}, ${g}, ${b})`;
        ctx!.fillText(cell.char, x + CONFIG.cellW * 0.5, y + CONFIG.cellH * 0.5);
      }

      const stillActive =
        activeCells.size > 0 ||
        activeDrops.length > 0 ||
        liveCount > 0 ||
        activeRipples.length > 0 ||
        activePackets.length > 0 ||
        activeAgents.length > 0 ||
        activeLatticePulses.length > 0;

      if (isVisible && !reducedMotion && stillActive) {
        animFrameId = requestAnimationFrame(animate);
      } else {
        animFrameId = 0;
      }
    }
  })();
</script>
