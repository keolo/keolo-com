---
// src/components/HeroAsciiBackground.astro
---

<canvas id="hero-ascii-bg" class="absolute inset-0 pointer-events-none z-0" aria-hidden="true"
></canvas>

<script>
  (() => {
    // === Configuration ===
    const CONFIG = {
      cellW: 9,
      cellH: 10,
      fontSize: 10,
      bgColor: '#09090b',
      bgShimmerCount: 30, // Subtle standby grid texture
    };

    const CHARS_LIGHT = ['░', '▖', '▗', '▘', '▝'];
    const CHARS_MEDIUM = ['▒', '▀', '▄', '▌', '▐', '▞', '▚'];
    const CHARS_DENSE = ['█', '▓', '▛', '▜', '▙', '▟', '▀', '▄', '▌', '▐'];
    const CHARS_BG = ['░', '▒', '▖', '▗', '▘', '▝', '▚', '▞', '▀', '▄', '▌', '▐'];

    const PALETTE = [
      [255, 59, 48], // Red
      [255, 112, 52], // Coral / Orange
      [255, 179, 38], // Amber
      [245, 224, 52], // Yellow
      [120, 235, 72], // Lime
      [34, 214, 118], // Emerald
      [24, 218, 224], // Cyan
      [56, 152, 255], // Sky Blue
      [99, 102, 241], // Indigo
      [176, 102, 255], // Violet
      [244, 72, 150], // Magenta
    ];

    const WHITE_HIGHLIGHT = [245, 248, 255];
    const BG_TEXT_BASE = [24, 24, 28];

    const canvas = document.getElementById('hero-ascii-bg') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    const baseCanvas = document.createElement('canvas');
    const baseCtx = baseCanvas.getContext('2d', { alpha: false });
    if (!baseCtx) return;

    const FONT = `${CONFIG.fontSize}px "JetBrains Mono", "SF Mono", ui-monospace, Menlo, Consolas, monospace`;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let cols = 0;
    let rows = 0;

    interface ActiveCell {
      col: number;
      row: number;
      energy: number;
      decay: number;
      isWhite: boolean;
      r: number;
      g: number;
      b: number;
      char: string;
      nextMutate: number;
    }
    const activeCells = new Map<number, ActiveCell>();

    function cellHash(col: number, row: number) {
      let h = (col * 374761393 + row * 668265263) | 0;
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return (h ^ (h >>> 16)) >>> 0;
    }

    function pick<T>(arr: T[]): T {
      return arr[(Math.random() * arr.length) | 0];
    }

    function charForEnergy(energy: number, hash?: number) {
      const list = energy > 0.65 ? CHARS_DENSE : energy > 0.3 ? CHARS_MEDIUM : CHARS_LIGHT;
      return hash !== undefined ? list[hash % list.length] : pick(list);
    }

    function bgShadeAt(col: number, row: number) {
      const wave =
        Math.sin(col * 0.17 + row * 0.09) * 0.5 + Math.cos(col * 0.08 - row * 0.21) * 0.5;
      const jitter = (Math.random() - 0.5) * 10;
      const v = Math.max(14, Math.min(34, Math.round(21 + wave * 4 + jitter)));
      return `rgb(${v}, ${v}, ${v + 2})`;
    }

    function drawBaseCell(col: number, row: number) {
      const x = col * CONFIG.cellW;
      const y = row * CONFIG.cellH;
      baseCtx!.fillStyle = CONFIG.bgColor;
      baseCtx!.fillRect(x, y, CONFIG.cellW, CONFIG.cellH);
      baseCtx!.fillStyle = bgShadeAt(col, row);
      baseCtx!.fillText(pick(CHARS_BG), x + CONFIG.cellW * 0.5, y + CONFIG.cellH * 0.5);
    }

    function setupCanvas(targetCanvas: HTMLCanvasElement, targetCtx: CanvasRenderingContext2D) {
      targetCanvas.width = Math.floor(width * dpr);
      targetCanvas.height = Math.floor(height * dpr);
      targetCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      targetCtx.font = FONT;
      targetCtx.textAlign = 'center';
      targetCtx.textBaseline = 'middle';
    }

    function rebuildBaseGrid() {
      baseCtx!.fillStyle = CONFIG.bgColor;
      baseCtx!.fillRect(0, 0, width, height);
      for (let r = 0; r < rows; r++) {
        const cy = r * CONFIG.cellH + CONFIG.cellH * 0.5;
        for (let c = 0; c < cols; c++) {
          baseCtx!.fillStyle = bgShadeAt(c, r);
          baseCtx!.fillText(pick(CHARS_BG), c * CONFIG.cellW + CONFIG.cellW * 0.5, cy);
        }
      }
    }

    // igniteCell function for active cell decay engine
    function igniteCell(
      col: number,
      row: number,
      energy: number,
      decay: number,
      rgb: number[],
      now: number,
      isWhite = false
    ) {
      if (col < 0 || col >= cols || row < 0 || row >= rows) return;
      const idx = row * cols + col;
      const existing = activeCells.get(idx);

      if (existing) {
        if (energy >= existing.energy * 0.72) {
          existing.energy = Math.max(existing.energy, Math.min(1, energy));
          existing.decay = Math.min(existing.decay, decay);
          if (isWhite) existing.isWhite = true;
          if (rgb && energy >= 0.45) {
            existing.r = rgb[0];
            existing.g = rgb[1];
            existing.b = rgb[2];
          }
          existing.char = charForEnergy(existing.energy);
        }
      } else {
        const color = rgb || PALETTE[cellHash(col, row) % PALETTE.length];
        activeCells.set(idx, {
          col,
          row,
          energy: Math.min(1, energy),
          decay,
          r: color[0],
          g: color[1],
          b: color[2],
          isWhite,
          char: charForEnergy(Math.min(1, energy)),
          nextMutate: now + 75 + Math.random() * 140,
        });
      }
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      cols = Math.ceil(width / CONFIG.cellW);
      rows = Math.ceil(height / CONFIG.cellH);

      const cellsCount = cols * rows;
      lifeGrid = new Uint8Array(cellsCount);
      nextLifeGrid = new Uint8Array(cellsCount);
      lifeAge = new Uint8Array(cellsCount);

      setupCanvas(canvas, ctx!);
      setupCanvas(baseCanvas, baseCtx!);
      rebuildBaseGrid();
      activeCells.clear();
    }

    window.addEventListener('resize', resize);
    resize();

    // === Simulation Modes ===
    const mode = 'life' as string; // Set to life for now for testing, will be randomized in T4

    // === Life Simulation State ===
    let lifeGrid: Uint8Array;
    let nextLifeGrid: Uint8Array;
    let lifeAge: Uint8Array;
    let lastLifeStep = performance.now();

    // === Rain Simulation State ===

    interface RainDrop {
      col: number;
      row: number;
      speed: number;
      color: number[];
      decay: number;
    }

    const activeDrops: RainDrop[] = [];

    function spawnDrop(col: number, startRow = -1) {
      if (col < 0 || col >= cols) return;
      activeDrops.push({
        col,
        row: startRow,
        speed: 18 + Math.random() * 24, // 18-42 cells/sec
        color: pick(PALETTE),
        decay: 0.8 + Math.random() * 1.2,
      });
    }

    let lastMouseCol = -1;

    window.addEventListener('pointermove', (e) => {
      if (reducedMotion) return;
      const x = e.clientX;
      const y = e.clientY;
      const col = Math.floor(x / CONFIG.cellW);
      const row = Math.floor(y / CONFIG.cellH);

      if (mode === 'rain') {
        if (col !== lastMouseCol) {
          spawnDrop(col, row);
          lastMouseCol = col;
        }
      } else if (mode === 'life' && lifeGrid) {
        if (col >= 0 && col < cols && row >= 0 && row < rows) {
          for (let dy = -1; dy <= 1; dy++) {
            for (let dx = -1; dx <= 1; dx++) {
              if (Math.random() > 0.5) {
                const r = row + dy;
                const c = col + dx;
                if (r >= 0 && r < rows && c >= 0 && c < cols) {
                  lifeGrid[r * cols + c] = 1;
                }
              }
            }
          }
        }
      }
    });

    window.addEventListener('pointerdown', (e) => {
      if (reducedMotion) return;
      const x = e.clientX;
      const y = e.clientY;
      const centerCol = Math.floor(x / CONFIG.cellW);
      const centerRow = Math.floor(y / CONFIG.cellH);

      if (mode === 'rain') {
        for (let i = -12; i <= 12; i++) {
          const rowOffset = Math.random() * 4 + Math.abs(i) * 0.5;
          spawnDrop(centerCol + i, centerRow - rowOffset);
        }
      } else if (mode === 'life' && lifeGrid) {
        for (let dy = -5; dy <= 5; dy++) {
          for (let dx = -5; dx <= 5; dx++) {
            if (dx * dx + dy * dy <= 25) {
              if (Math.random() > 0.3) {
                const r = centerRow + dy;
                const c = centerCol + dx;
                if (r >= 0 && r < rows && c >= 0 && c < cols) {
                  lifeGrid[r * cols + c] = 1;
                }
              }
            }
          }
        }
      }
    });

    let lastTime = performance.now();

    function animate(now: number) {
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;

      if (!reducedMotion && cols > 0 && rows > 0) {
        for (let i = 0; i < CONFIG.bgShimmerCount; i++) {
          drawBaseCell((Math.random() * cols) | 0, (Math.random() * rows) | 0);
        }
      }

      ctx!.setTransform(1, 0, 0, 1, 0, 0);
      ctx!.drawImage(baseCanvas, 0, 0);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const stepDt = reducedMotion ? dt * 0.35 : dt;

      // === Rain Simulation Step ===
      if (mode === 'rain' && !reducedMotion) {
        if (Math.random() < stepDt * 4.0) {
          // Ambient drops
          spawnDrop(Math.floor(Math.random() * cols), -1);
        }

        for (let i = activeDrops.length - 1; i >= 0; i--) {
          const drop = activeDrops[i];
          const oldRow = Math.floor(drop.row);
          drop.row += drop.speed * stepDt;
          const newRow = Math.floor(drop.row);

          if (newRow > oldRow) {
            for (let r = oldRow + 1; r <= newRow; r++) {
              if (r >= 0 && r < rows) {
                igniteCell(drop.col, r, 1.0, drop.decay, drop.color, now, true);
              }
            }
          }

          if (drop.row >= rows + 5) {
            activeDrops.splice(i, 1);
          }
        }
      }

      // === Life Simulation Step ===
      if (mode === 'life' && !reducedMotion && lifeGrid) {
        if (now - lastLifeStep >= 88) {
          lastLifeStep = now;
          for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
              const idx = r * cols + c;
              let neighbors = 0;
              for (let dy = -1; dy <= 1; dy++) {
                for (let dx = -1; dx <= 1; dx++) {
                  if (dx === 0 && dy === 0) continue;
                  const nr = r + dy;
                  const nc = c + dx;
                  if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
                    neighbors += lifeGrid[nr * cols + nc];
                  }
                }
              }
              const isAlive = lifeGrid[idx];
              if (isAlive) {
                if (neighbors === 2 || neighbors === 3) {
                  nextLifeGrid[idx] = 1;
                  lifeAge[idx] = Math.min(255, lifeAge[idx] + 1);
                } else {
                  nextLifeGrid[idx] = 0;
                  lifeAge[idx] = 0;
                }
              } else {
                if (neighbors === 3) {
                  nextLifeGrid[idx] = 1;
                  lifeAge[idx] = 0;
                } else {
                  nextLifeGrid[idx] = 0;
                  lifeAge[idx] = 0;
                }
              }
            }
          }
          const temp = lifeGrid;
          lifeGrid = nextLifeGrid;
          nextLifeGrid = temp;
          nextLifeGrid.fill(0);

          for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
              const idx = r * cols + c;
              if (lifeGrid[idx]) {
                const age = lifeAge[idx];
                const energy = age === 0 ? 1.0 : Math.max(0.3, 0.8 - age * 0.02);
                const isWhite = age === 0;
                const color = PALETTE[cellHash(c, r) % PALETTE.length];
                igniteCell(c, r, energy, 0.6, color, now, isWhite);
              }
            }
          }
        }
      }

      for (const [idx, cell] of activeCells) {
        cell.energy -= cell.decay * stepDt;

        if (cell.energy <= 0.02) {
          activeCells.delete(idx);
          continue;
        }

        if (cell.isWhite && cell.energy < 0.84) {
          cell.isWhite = false;
        }

        if (!reducedMotion && now >= cell.nextMutate) {
          cell.char = charForEnergy(cell.energy);
          cell.nextMutate = now + 85 + Math.random() * 150;
        }

        const e = Math.pow(Math.min(1, cell.energy), 0.85);
        const srcR = cell.isWhite ? WHITE_HIGHLIGHT[0] : cell.r;
        const srcG = cell.isWhite ? WHITE_HIGHLIGHT[1] : cell.g;
        const srcB = cell.isWhite ? WHITE_HIGHLIGHT[2] : cell.b;

        const r = (BG_TEXT_BASE[0] + (srcR - BG_TEXT_BASE[0]) * e) | 0;
        const g = (BG_TEXT_BASE[1] + (srcG - BG_TEXT_BASE[1]) * e) | 0;
        const b = (BG_TEXT_BASE[2] + (srcB - BG_TEXT_BASE[2]) * e) | 0;

        const x = cell.col * CONFIG.cellW;
        const y = cell.row * CONFIG.cellH;

        ctx!.fillStyle = CONFIG.bgColor;
        ctx!.fillRect(x, y, CONFIG.cellW, CONFIG.cellH);
        ctx!.fillStyle = `rgb(${r}, ${g}, ${b})`;
        ctx!.fillText(cell.char, x + CONFIG.cellW * 0.5, y + CONFIG.cellH * 0.5);
      }

      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
  })();
</script>
