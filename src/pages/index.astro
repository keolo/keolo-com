---
import BaseLayout from '../layouts/BaseLayout.astro';
import MotionReveal from '../components/MotionReveal.astro';
import DecipherText from '../components/DecipherText.astro';
import HeroAsciiBackground from '../components/HeroAsciiBackground.astro';
import { getPublishedPosts, getPublishedProjects, isEhrSeriesPost } from '../lib/content';

const allPosts = await getPublishedPosts();
const standalonePosts = allPosts.filter((p) => !isEhrSeriesPost(p.slug));
const ehrIndex = allPosts.find((p) => p.slug === 'how-to-build-an-ehr');
const featuredPosts = [...standalonePosts.slice(0, 4), ...(ehrIndex ? [ehrIndex] : [])].slice(0, 5);
const projects = await getPublishedProjects();

const highlights = [
  {
    label: '0→1 Delivery',
    detail: '25+ MVPs, Agentic Systems; 4M+ OSS downloads; 4x velocity',
  },
  {
    label: 'Hyper Scaling',
    detail: '0→30 team growth, <1% attrition; Pre-seed to Series C',
  },
  {
    label: 'Strategic Impact',
    detail: 'Built tech behind 5 startup exits (and counting)',
  },
  {
    label: 'Compliance',
    detail: 'SOC 2 • HIPAA • HITRUST',
  },
];
---

<BaseLayout
  title="Keolo"
  description="Tech leadership for high-stakes startups. Fractional CTO for AI, HealthTech & FinTech startups at Aliveness Ventures."
  headerPlacement="below-hero"
>
  <Fragment slot="hero">
    <section
      class="relative flex w-full min-h-screen min-h-[100dvh] flex-col justify-end overflow-hidden bg-graphite-950 px-4 pb-24 pt-16 text-white sm:px-6 sm:pb-28 lg:px-8 lg:pb-32"
    >
      <HeroAsciiBackground />

      <!-- Ambient background glow for visual depth -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div
          class="hero-glow-enter absolute -top-32 left-1/2 h-[480px] w-[750px] -translate-x-1/2 rounded-full bg-radial from-white/[0.05] via-white/[0.015] to-transparent blur-3xl"
        >
        </div>
      </div>

      <div class="relative z-10 mx-auto w-full max-w-5xl">
        <div
          class="hero-card-enter w-full max-w-5xl rounded-2xl bg-graphite-950/5 p-6 sm:rounded-3xl sm:p-8 md:p-10 backdrop-blur-xs"
        >
          <p
            class="hero-badge-enter inline-flex items-center gap-2.5 rounded-full border border-graphite-800/90 bg-graphite-900/80 px-3.5 py-1 text-xs font-medium text-graphite-300 shadow-[0_0_20px_-3px_rgba(255,255,255,0.04)] backdrop-blur-md transition hover:border-graphite-700"
          >
            <span class="relative flex h-2 w-2 items-center justify-center" aria-hidden="true">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"
              ></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            </span>
            <span>Fractional CTO &bull; AI, HealthTech &amp; FinTech</span>
          </p>
          <h1
            class="hero-title-enter mt-6 text-4xl font-bold tracking-tight text-white sm:text-5xl sm:leading-[1.1]"
          >
            <span
              class="bg-gradient-to-r from-white via-graphite-100 to-graphite-300 bg-clip-text text-transparent"
            >
              Keolo
            </span>
          </h1>
          <DecipherText class="mt-6 text-lg leading-relaxed text-graphite-300 sm:text-xl" />

          <div class="hero-cta-enter mt-8 flex flex-wrap items-center gap-3">
            <a
              href="https://calendar.google.com/calendar/appointments/schedules/AcZssZ1Egyi1WiHd5jvKcIoI3B6T9NnGpeIssIZd7vGybBS6Sl_JyUBMjMk7Lp3YL2GCfb_GjyVjbDMI?gv=true"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 text-sm font-medium text-graphite-950 shadow-[0_0_20px_-3px_rgba(255,255,255,0.2)] transition duration-200 hover:bg-graphite-200 hover:shadow-[0_0_25px_0px_rgba(255,255,255,0.3)] active:scale-[0.98]"
            >
              <span>Book a Call</span>
              <span
                class="transition-transform duration-200 group-hover:translate-x-0.5"
                aria-hidden="true">&rarr;</span
              >
            </a>
            <a
              href="/about/"
              class="inline-flex items-center gap-2 rounded-lg border border-graphite-800 bg-graphite-900/60 px-5 py-3 text-sm font-medium text-graphite-200 backdrop-blur-sm transition duration-200 hover:border-graphite-700 hover:bg-graphite-800 active:scale-[0.98]"
            >
              About &amp; Engagement Models
            </a>
          </div>
        </div>
      </div>

      <div class="hero-scroll-enter absolute bottom-8 left-1/2 -translate-x-1/2">
        <a
          href="#content"
          aria-label="Scroll down"
          class="group flex flex-col items-center gap-1.5 text-graphite-500 transition-colors duration-200 hover:text-white"
        >
          <span
            class="text-[10px] font-medium tracking-widest text-graphite-500 uppercase opacity-80 transition-colors group-hover:text-graphite-300"
            >Scroll</span
          >
          <svg
            class="h-5 w-5 transition-transform duration-200 group-hover:translate-y-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>
      </div>
    </section>
  </Fragment>

  <div id="content" class="scroll-mt-16">
    <section aria-label="Highlights">
      <MotionReveal class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          highlights.map((item) => (
            <div class="rounded-2xl border border-graphite-200 bg-white p-6 shadow-xs transition hover:border-graphite-400">
              <h2 class="text-sm font-semibold tracking-tight text-graphite-950">{item.label}</h2>
              <p class="mt-2 text-sm leading-relaxed text-graphite-600">{item.detail}</p>
            </div>
          ))
        }
      </MotionReveal>
    </section>

    <MotionReveal class="mt-16 border-t border-graphite-200 pt-14">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold tracking-wider text-graphite-500 uppercase">
            Selected Work
          </p>
          <h2 class="mt-1 text-2xl font-bold tracking-tight text-graphite-950">Projects</h2>
        </div>
        <a href="/projects/" class="text-sm font-medium text-graphite-600 hover:text-graphite-950">
          All projects →
        </a>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          projects.map((project) => (
            <a
              href={`/projects/${project.slug}/`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-graphite-200 bg-white transition hover:border-graphite-400"
            >
              {project.data.cover?.image && (
                <div class="aspect-16/10 overflow-hidden bg-graphite-100">
                  <img
                    src={
                      project.data.cover.image.startsWith('/')
                        ? project.data.cover.image
                        : `/${project.data.cover.image}`
                    }
                    alt={project.data.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-semibold text-graphite-950 group-hover:underline">
                  {project.data.title}
                </h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-graphite-600">
                  {project.data.description}
                </p>
                <span class="mt-4 text-xs font-semibold text-graphite-800">Read case study →</span>
              </div>
            </a>
          ))
        }
      </div>
    </MotionReveal>

    <MotionReveal class="mt-16 border-t border-graphite-200 pt-14">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold tracking-wider text-graphite-500 uppercase">Writing</p>
          <h2 class="mt-1 text-2xl font-bold tracking-tight text-graphite-950">Latest Posts</h2>
        </div>
        <a href="/posts/" class="text-sm font-medium text-graphite-600 hover:text-graphite-950">
          All posts →
        </a>
      </div>

      <div
        class="mt-8 divide-y divide-graphite-200 rounded-2xl border border-graphite-200 bg-white"
      >
        {
          featuredPosts.map((post) => (
            <a
              href={`/posts/${post.slug}/`}
              class="group flex flex-col justify-between gap-2 p-6 transition hover:bg-graphite-50 sm:flex-row sm:items-center"
            >
              <div>
                <h3 class="text-base font-semibold text-graphite-950 group-hover:underline">
                  {post.data.title}
                </h3>
                {post.data.description && (
                  <p class="mt-1 line-clamp-2 text-sm text-graphite-600">{post.data.description}</p>
                )}
              </div>
              <span class="shrink-0 text-sm font-medium text-graphite-500 group-hover:text-graphite-950">
                Read →
              </span>
            </a>
          ))
        }
      </div>
    </MotionReveal>
  </div>
</BaseLayout>

<style>
  /* Premium Hero Keyframe Animations */
  @keyframes heroFadeInUp {
    0% {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(6px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes heroBadgeFade {
    0% {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes heroCardFade {
    0% {
      opacity: 0;
      transform: translateY(12px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroGlowFade {
    0% {
      opacity: 0;
      transform: translate(-50%, -10px) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
  }

  @keyframes heroScrollFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  .hero-glow-enter {
    animation: heroGlowFade 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0s both;
  }

  .hero-card-enter {
    animation: heroCardFade 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0s both;
  }

  .hero-badge-enter {
    animation: heroBadgeFade 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }

  .hero-title-enter {
    animation: heroFadeInUp 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.16s both;
  }

  .hero-cta-enter {
    animation: heroFadeInUp 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.38s both;
  }

  .hero-scroll-enter {
    animation: heroBadgeFade 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.85s both;
  }

  .hero-scroll-enter a {
    animation: heroScrollFloat 3.2s ease-in-out 1.8s infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow-enter,
    .hero-card-enter,
    .hero-badge-enter,
    .hero-title-enter,
    .hero-cta-enter,
    .hero-scroll-enter,
    .hero-scroll-enter a {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>
