---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedProjects } from '../../lib/content';

const projects = await getPublishedProjects();
---

<BaseLayout
  title="Projects"
  description="Selected product engineering and Fractional CTO case studies: JOYO, Global Peace Yes, and Riiu."
>
  <section>
    <header class="mb-10 border-b border-graphite-200 pb-8">
      <p class="text-xs font-semibold tracking-wider text-graphite-500 uppercase">Case Studies</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-graphite-950 sm:text-4xl">Projects</h1>
      <p class="mt-3 max-w-2xl text-base text-graphite-600">
        Venture studio launches and zero-to-one products architected, built, and scaled with
        founders.
      </p>
    </header>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-2">
      {
        projects.map((project) => (
          <a
            href={`/projects/${project.slug}/`}
            class="group flex flex-col overflow-hidden rounded-2xl border border-graphite-200 bg-white transition hover:border-graphite-400"
          >
            {project.data.cover?.image ? (
              <div class="aspect-16/10 overflow-hidden bg-graphite-100">
                <img
                  src={
                    project.data.cover.image.startsWith('/')
                      ? project.data.cover.image
                      : `/${project.data.cover.image}`
                  }
                  alt={project.data.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </div>
            ) : (
              <div class="aspect-16/10 flex items-center justify-center bg-graphite-50 border-b border-graphite-100">
                <span class="text-4xl font-bold text-graphite-200 uppercase tracking-widest group-hover:text-graphite-300 transition-colors">
                  {project.data.title.slice(0, 2)}
                </span>
              </div>
            )}
            <div class="flex flex-1 flex-col p-6">
              <h2 class="text-xl font-semibold text-graphite-950 group-hover:underline">
                {project.data.title}
              </h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-graphite-600">
                {project.data.description}
              </p>
              <span class="mt-5 text-sm font-medium text-graphite-900">View case study →</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
