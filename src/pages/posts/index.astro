---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, isEhrSeriesPost } from '../../lib/content';

const posts = await getPublishedPosts();
const standalonePosts = posts.filter((p) => !isEhrSeriesPost(p.slug));
const ehrPosts = posts.filter((p) => isEhrSeriesPost(p.slug));
const ehrIndex = ehrPosts.find((p) => p.slug === 'how-to-build-an-ehr');
const ehrChapters = ehrPosts.filter((p) => p.slug !== 'how-to-build-an-ehr');
---

<BaseLayout
  title="Posts"
  description="Articles on agentic AI engineering, spec-driven development, system architecture, and building compliant HealthTech products."
>
  <section class="mx-auto max-w-3xl">
    <header class="mb-10 border-b border-graphite-200 pb-8">
      <p class="text-xs font-semibold tracking-wider text-graphite-500 uppercase">Writing</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-graphite-950 sm:text-4xl">Posts</h1>
      <p class="mt-3 text-base text-graphite-600">
        Essays on engineering leadership, AI systems, architecture, and shipping regulated products.
      </p>
    </header>

    <div class="divide-y divide-graphite-200 rounded-2xl border border-graphite-200 bg-white">
      {
        standalonePosts.map((post) => (
          <a href={`/posts/${post.slug}/`} class="group block p-6 transition hover:bg-graphite-50">
            <div class="flex items-center gap-2">
              <h2 class="text-lg font-semibold text-graphite-950 group-hover:underline">
                {post.data.title}
              </h2>
              {post.data.draft && (
                <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">
                  Draft
                </span>
              )}
            </div>
            {post.data.description && (
              <p class="mt-2 text-sm leading-relaxed text-graphite-600">{post.data.description}</p>
            )}
            {post.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {post.data.tags.map((tag) => (
                  <span class="rounded-full bg-graphite-100 px-2.5 py-0.5 text-xs text-graphite-600">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))
      }
    </div>

    {
      ehrIndex && (
        <section class="mt-14 rounded-2xl border border-graphite-200 bg-white p-6 sm:p-8">
          <p class="text-xs font-semibold tracking-wider text-graphite-500 uppercase">
            Multi-Part Tutorial Series
          </p>
          <a href={`/posts/${ehrIndex.slug}/`} class="group mt-2 block">
            <h2 class="text-2xl font-bold tracking-tight text-graphite-950 group-hover:underline">
              {ehrIndex.data.title}
            </h2>
          </a>
          <p class="mt-2 text-sm text-graphite-600">
            End-to-end architectural and implementation guide for building a compliant Electronic
            Health Record (EHR) platform.
          </p>

          <ol class="mt-6 space-y-2">
            {ehrChapters.map((chapter, idx) => (
              <li>
                <a
                  href={`/posts/${chapter.slug}/`}
                  class="flex items-center justify-between rounded-lg border border-graphite-100 px-4 py-2.5 text-sm transition hover:border-graphite-300 hover:bg-graphite-50"
                >
                  <span class="flex items-center gap-3 font-medium text-graphite-900">
                    <span class="font-mono text-xs text-graphite-400">
                      {String(idx + 1).padStart(2, '0')}
                    </span>
                    {chapter.data.title}
                    {chapter.data.draft && (
                      <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">
                        Draft
                      </span>
                    )}
                  </span>
                  <span class="text-graphite-400">→</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </section>
</BaseLayout>
